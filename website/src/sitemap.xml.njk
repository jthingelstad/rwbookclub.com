---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- lastmod only where a page has a date of its own: a book page's meeting, once
    it has happened. Section, member, list and author pages change with reviews,
    bios and picks that carry no date here, so they leave lastmod off rather than
    all claiming the newest meeting. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/about/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/stats/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/books/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/members/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/lists/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/authors/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/meetings/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/oliver/</loc>
  </url>
  {%- for book in books %}
  <url>
    <loc>{{ site.url }}/books/{{ book.slug }}/</loc>
    {%- if book.meetingDate and not book.isUpcoming %}
    <lastmod>{{ book.meetingDate }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
  {%- for m in currentMembers %}
  <url>
    <loc>{{ site.url }}/members/{{ m.slug }}/</loc>
  </url>
  {%- endfor %}
  {%- for l in lists %}
  <url>
    <loc>{{ site.url }}/lists/{{ l.slug }}/</loc>
  </url>
  {%- endfor %}
  {%- for a in authors %}
  <url>
    <loc>{{ site.url }}/authors/{{ a.slug }}/</loc>
  </url>
  {%- endfor %}
</urlset>
