{
  "name": "rwbookclub-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the R/W Book Club: the website, the knowledge corpus, and the Discord agent (Oliver).",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "website"
  ],
  "overrides": {
    "@11ty/eleventy": {
      "@11ty/recursive-copy": "5.0.2"
    },
    "brace-expansion": "5.0.12",
    "gray-matter": {
      "js-yaml": {
        "argparse": "2.0.1"
      }
    }
  },
  "scripts": {
    "build": "npm run build -w website",
    "test": "npm run test -w website && node --test tests/aws-hosting.test.mjs",
    "serve": "npm run serve -w website",
    "clean": "npm run clean -w website",
    "covers": "uv run --locked python -m corpus.images",
    "deploy": "uv run --locked python -m agent.publish",
    "infra:generate": "node infra/templates.mjs",
    "infra": "node scripts/infra.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1157.0",
    "@aws-sdk/client-cloudformation": "^3.1157.0",
    "@aws-sdk/client-cloudfront": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/client-sts": "^3.1157.0"
  }
}
